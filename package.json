{
  "name": "gsea-attendance",
  "version": "1.0.0",
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./src/input.css -o ./output.css && node scripts/safari-compat.js",
    "build:min": "npx @tailwindcss/cli -i ./src/input.css -o ./output.css --minify && node scripts/safari-compat.js",
    "watch": "npx @tailwindcss/cli -i ./src/input.css -o ./output.css --watch",
    "package:moodle": "npm run build && zip -FS -r gsea-attendance-moodle.zip imsmanifest.xml index.html ie.html output.css gform-config.json"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
